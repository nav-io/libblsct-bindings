 size_t blsct::Common::PoolThreads(size_t threads, size_t work_items)
 {
+#ifdef WASM_SINGLE_THREADED
+    // WASM build without pthreads: every worker pool sized here (aggregate
+    // signature verify, range proof verify and amount recovery, view tags)
+    // runs on the calling thread.
+    (void)threads;
+    (void)work_items;
+    return 1;
+#else
     if (threads == 0) threads = std::thread::hardware_concurrency();
     return std::max<size_t>(1, std::min(threads, work_items));
+#endif
 }
 
